# Enables the Claude-powered sous-chef. Without it the cook-mode assistant
# falls back to a built-in rule-based helper.
ANTHROPIC_API_KEY=
# Model that runs the sous-chef (default: claude-opus-5-5). Compare models first with `npm run eval:chef`.
CHEF_MODEL=

# --- AI spending guard rails ---
# Hard monthly cap on AI spend in USD, shared by all users (default: 80). When it's used up,
# cook mode switches to basic mode until the next month. 0 turns the AI chef off.
AI_MONTHLY_BUDGET_USD=
# AI cook sessions one person can start per 24 hours (default: 10)
AI_SESSIONS_PER_USER_PER_DAY=
# Optional Slack or Discord incoming-webhook URL for budget alerts at 50%, 80% and 100%
ALERT_WEBHOOK_URL=
# Where the SQLite database and uploaded photos live (default: ./data)
DATA_DIR=

# --- Recitapa Plus ---
# Web payments (Stripe). Create a product with a monthly and a yearly price.
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Signing secret for the webhook endpoint /api/billing/stripe-webhook
STRIPE_WEBHOOK_SECRET=

# iOS in-app purchases (RevenueCat). The public key ships in the app; the secret stays on the server.
NEXT_PUBLIC_REVENUECAT_IOS_KEY=
REVENUECAT_SECRET_KEY=
# Value RevenueCat sends as "Authorization: Bearer <secret>" to /api/billing/revenuecat-webhook
REVENUECAT_WEBHOOK_SECRET=
# Entitlement identifier configured in RevenueCat (default: plus)
REVENUECAT_ENTITLEMENT=

# Local testing only (ignored in production): adds a "toggle Plus" button on /plus
BILLING_DEV_MODE=

# Links shown on the subscription screen (required by Apple for subscriptions)
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
